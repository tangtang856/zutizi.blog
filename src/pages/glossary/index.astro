---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const title = "科学上网术语知识百科 - 协议/专线/规则概念详解 - 竹梯子博客";
const description = "科学上网核心概念百科词库。通俗解释IPLC专线、BGP中继、Shadowsocks、VLESS Reality、DNS污染、TUN模式及策略组工作原理。";
const keywords = "翻墙术语, 科学上网概念, IPLC原理解析, Clash规则组, 代理协议科普";

const terms = await getCollection('glossary');
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <div class="max-w-content mx-auto px-4 sm:px-6 pt-4 pb-16">
    <Breadcrumbs items={[{ name: "知识百科" }]} />
    <header class="mb-10 text-center sm:text-left">
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight sm:text-4xl">科学上网技术百科与概念术语库</h1>
      <p class="mt-2 text-sm text-slate-600 max-w-2xl leading-relaxed">
        系统剖析网络审查防御、加密传输协议演进与全球骨干光纤拓扑底层逻辑。
      </p>
    </header>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {terms.map(t => (
        <a href={`/glossary/${t.slug}/`} class="p-6 bg-white border border-slate-200 hover:border-blue-500 rounded-2xl transition hover:shadow-md group flex flex-col justify-between">
          <div>
            <div class="text-xs text-blue-600 font-semibold mb-1">{t.data.category}</div>
            <h3 class="font-bold text-slate-900 text-lg group-hover:text-blue-600 transition mb-2">{t.data.term}</h3>
            <p class="text-xs text-slate-600 leading-relaxed line-clamp-3">{t.data.description}</p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-100 text-xs font-semibold text-blue-600 flex items-center justify-between">
            <span>查阅百科</span><span>&rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
