---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const title = "编辑政策与评测标准 - 坚持实测与中立原则 - 竹梯子博客";
const description = "竹梯子博客编辑政策与评测标准。明确公开测速测试环境、数据采集规范、拒绝买榜承诺与赞助商利益披露准则。";
const keywords = "编辑政策, 评测标准, 客观中立, 数据采集准则, 防跑路规范";
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <div class="max-w-content mx-auto px-4 sm:px-6 pt-4 pb-16">
    <Breadcrumbs items={[{ name: "编辑政策" }]} />
    <div class="max-w-reading mx-auto mt-4 bg-white rounded-2xl border border-slate-200 p-6 sm:p-10 shadow-sm leading-relaxed text-sm text-slate-700">
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mb-6 border-b border-slate-100 pb-4">编辑政策与评测标准</h1>
      <p class="mb-4">
        为确保本站所有评测数据与排行榜单的真实性、公信力与读者选购安全，竹梯子博客恪守以下编辑准则：
      </p>
      <h2 class="text-xl font-bold text-slate-900 mt-6 mb-3 border-l-4 border-blue-600 pl-3">一、实测数据与公开资料严格区分</h2>
      <p class="mb-4">
        页面中明确标注“官方公开数据”与“编辑部实测数据”。官方宣传的千兆带宽必须通过晚高峰实际测试验证，未经验证的绝不采纳为评分依据。
      </p>
      <h2 class="text-xl font-bold text-slate-900 mt-6 mb-3 border-l-4 border-blue-600 pl-3">二、晚高峰连续监测</h2>
      <p class="mb-4">
        所有线路质量测试均在中国三大电信运营商家庭千兆宽带网络下进行，时间窗口统一设为网络拥塞严重的 20:30 - 23:00。
      </p>
      <h2 class="text-xl font-bold text-slate-900 mt-6 mb-3 border-l-4 border-blue-600 pl-3">三、推广链接与中立性披露</h2>
      <p>
        本站部分推荐链接含有推广返利（Affiliate），但返利绝对不影响排行榜评测打分与客观缺点揭示。若品牌发生跑路或严重劣化，本站将第一时间标记警示。
      </p>
    </div>
  </div>
</BaseLayout>
