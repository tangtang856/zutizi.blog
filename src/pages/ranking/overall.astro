---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AirportCard from '../../components/AirportCard.astro';
import { AIRPORTS } from '../../data/airports';

const title = "2026综合机场排行榜 - 晚高峰测速、稳定性与解锁全维度排名 - 竹梯子博客";
const description = "2026年最新翻墙机场综合排行榜。基于中国三大运营商晚高峰连续实测，客观评估微风网络、灵猫、浪网等14家核心品牌的延迟、带宽、丢包与解锁表现。";
const keywords = "机场排行榜, 机场综合排行, 梯子排行榜, 稳定机场推荐, 晚高峰测速排行";

const sortedAirports = [...AIRPORTS];
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
>
  <div class="max-w-content mx-auto px-4 sm:px-6 pt-4 pb-16">
    <Breadcrumbs
      items={[
        { name: "排行榜", href: "/ranking/overall/" },
        { name: "综合排行榜" }
      ]}
    />

    <header class="mb-8">
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight sm:text-4xl">
        2026 翻墙机场综合排行榜 (全维度实测)
      </h1>
      <p class="mt-2 text-sm text-slate-600 max-w-2xl leading-relaxed">
        结合网络延迟、晚高峰抗丢包表现、多流并发吞吐、AI/流媒体解锁覆盖率及每GB实际成本等真实维度进行综合评估，拒绝虚假刷榜。
      </p>
    </header>

    <!-- Sub Nav -->
    <div class="flex items-center gap-2 mb-8 border-b border-slate-200 pb-3 overflow-x-auto text-xs font-semibold">
      <a href="/ranking/overall/" class="bg-blue-600 text-white px-3 py-1.5 rounded-lg whitespace-nowrap">综合榜</a>
      <a href="/ranking/value/" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-3 py-1.5 rounded-lg whitespace-nowrap">性价比榜</a>
      <a href="/ranking/budget/" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-3 py-1.5 rounded-lg whitespace-nowrap">低预算榜</a>
      <a href="/ranking/stable/" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-3 py-1.5 rounded-lg whitespace-nowrap">稳定专线榜</a>
    </div>

    <!-- Quick Table -->
    <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm mb-12">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="bg-slate-50 border-b border-slate-200 text-slate-700 font-semibold">
            <tr>
              <th class="py-3 px-4">排名</th>
              <th class="py-3 px-4">品牌名称</th>
              <th class="py-3 px-3">起步资费</th>
              <th class="py-3 px-3">额定流量</th>
              <th class="py-3 px-3">核心架构</th>
              <th class="py-3 px-3">设备并发</th>
              <th class="py-3 px-4">直达通道</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {sortedAirports.map((a, idx) => (
              <tr class="hover:bg-slate-50/50">
                <td class="py-3 px-4 font-bold text-slate-900">
                  <span class={`inline-flex items-center justify-center w-6 h-6 rounded-full text-xs font-extrabold ${
                    idx === 0 ? 'bg-amber-400 text-amber-950' :
                    idx === 1 ? 'bg-slate-300 text-slate-800' :
                    idx === 2 ? 'bg-amber-600 text-white' : 'bg-slate-100 text-slate-600'
                  }`}>
                    {idx + 1}
                  </span>
                </td>
                <td class="py-3 px-4 font-semibold text-slate-900">
                  <a href={`/review/${a.slug}/`} class="hover:text-blue-600">{a.name}</a>
                </td>
                <td class="py-3 px-3 font-bold text-blue-600">¥{a.startingPrice.toFixed(Number.isInteger(a.startingPrice)?0:1)}/{a.plans[0].billing}</td>
                <td class="py-3 px-3 font-semibold text-slate-800">{a.plans[0].trafficGb} GB</td>
                <td class="py-3 px-3 text-slate-600 text-xs">{a.protocols[0]} / 专线中继</td>
                <td class="py-3 px-3 text-slate-500 text-xs">{a.deviceLimit}</td>
                <td class="py-3 px-4">
                  <a href={a.affiliateUrl} target="_blank" rel="noopener nofollow" class="inline-block bg-blue-600 hover:bg-blue-700 text-white text-xs font-medium py-1 px-3 rounded">
                    官网直达
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Cards Grid -->
    <h2 class="text-2xl font-bold text-slate-900 mb-6">入榜品牌详细卡片与优缺点拆解</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedAirports.map(airport => (
        <AirportCard airport={airport} />
      ))}
    </div>
  </div>
</BaseLayout>
