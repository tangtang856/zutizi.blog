---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AirportCard from '../../components/AirportCard.astro';
import { AIRPORTS } from '../../data/airports';

const title = "稳定性机场排行榜 - IPLC/IEPL物理专线抗抖动排名 - 竹梯子博客";
const description = "稳定性机场排行榜。聚焦全天候不卡顿、晚高峰零丢包、低延迟内网光纤物理专线，评选最适合企业远程办公与外服游戏的优质机场。";
const keywords = "稳定机场推荐, IPLC专线机场, 晚高峰不卡顿梯子, 游戏加速专线, 企业办公翻墙";

// 筛选专线与高稳定性品牌
const stableAirports = AIRPORTS.filter(a =>
  a.description.includes("IPLC") ||
  a.description.includes("专线") ||
  a.advantages.some(adv => adv.includes("专线") || adv.includes("低延迟"))
);
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
>
  <div class="max-w-content mx-auto px-4 sm:px-6 pt-4 pb-16">
    <Breadcrumbs
      items={[
        { name: "排行榜", href: "/ranking/overall/" },
        { name: "稳定性排行榜" }
      ]}
    />

    <header class="mb-8">
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight sm:text-4xl">
        稳定性机场排行榜 (IPLC/IEPL 专线首选)
      </h1>
      <p class="mt-2 text-sm text-slate-600 max-w-2xl leading-relaxed">
        针对晚高峰丢包率持续低于 0.2% 的内网物理专线架构品牌，特别适合跨国远程办公、外服竞技游戏与关键生产力场景。
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {stableAirports.map(airport => (
        <AirportCard airport={airport} />
      ))}
    </div>
  </div>
</BaseLayout>
