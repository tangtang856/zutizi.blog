---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AirportCard from '../../components/AirportCard.astro';
import { AIRPORTS } from '../../data/airports';

const title = "高稳定专线机场推荐 - 全天候在线与跨国办公首选 - 竹梯子博客";
const description = "高稳定机场推荐专题。严格筛选具备多入口BGP负载均衡、晚高峰持续无卡顿、长连接不断连的优质中继与专线网络服务商。";
const keywords = "高稳定机场, 稳定梯子推荐, 跨国办公翻墙, 长期稳定节点, 远程办公加速";

const list = AIRPORTS.filter(a =>
  a.description.includes("专线") ||
  a.description.includes("稳定") ||
  a.advantages.some(adv => adv.includes("稳定") || adv.includes("低延迟"))
);
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
>
  <div class="max-w-content mx-auto px-4 sm:px-6 pt-4 pb-16">
    <Breadcrumbs
      items={[
        { name: "机场推荐", href: "/recommend/" },
        { name: "高稳定专线推荐" }
      ]}
    />

    <header class="mb-8">
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight sm:text-4xl">
        高稳定专线机场推荐 (商务办公与长效连接)
      </h1>
      <p class="mt-2 text-sm text-slate-600 max-w-2xl leading-relaxed">
        主打多机房冗余容灾，SSH/远程桌面长连接不掉线，告别晚高峰频繁飘黄与节点超时。
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {list.map(airport => (
        <AirportCard airport={airport} />
      ))}
    </div>
  </div>
</BaseLayout>
