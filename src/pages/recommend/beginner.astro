---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AirportCard from '../../components/AirportCard.astro';
import { AIRPORTS } from '../../data/airports';

const title = "新手入门机场推荐 - 一键导入订阅与全平台小白配置 - 竹梯子博客";
const description = "新手入门机场推荐专题。精选客服支持完善、具备一键导入客户端教程、小白操作友好、支持小额月付的翻墙机场服务商。";
const keywords = "新手机场推荐, 小白翻墙梯子, 一键导入机场, 简单好用梯子, 翻墙入门指南";

const list = AIRPORTS.filter(a => a.suitableFor.some(s => s.includes("新手") || s.includes("日常") || s.includes("学生")));
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
>
  <div class="max-w-content mx-auto px-4 sm:px-6 pt-4 pb-16">
    <Breadcrumbs
      items={[
        { name: "机场推荐", href: "/recommend/" },
        { name: "新手入门首选" }
      ]}
    />

    <header class="mb-8">
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight sm:text-4xl">
        新手入门机场推荐 (小白即开即用)
      </h1>
      <p class="mt-2 text-sm text-slate-600 max-w-2xl leading-relaxed">
        具备图形化傻瓜式订阅导入支持、中文客服响应及时且套餐定价透明，新手无需复杂配置即可秒开海外网络。
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {(list.length > 0 ? list : AIRPORTS.slice(0, 6)).map(airport => (
        <AirportCard airport={airport} />
      ))}
    </div>
  </div>
</BaseLayout>
