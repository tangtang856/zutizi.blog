---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AirportCard from '../../components/AirportCard.astro';
import { AIRPORTS } from '../../data/airports';

const title = "便宜低价机场推荐 - 月付¥10元以内高性价比梯子 - 竹梯子博客";
const description = "便宜低价机场推荐专题。盘点月付¥10元以内的优质稳定机场服务商，兼顾大流量与入门低门槛，附优惠券及实测每GB成本。";
const keywords = "便宜机场, 低价机场推荐, 10元内机场, 性价比翻墙, 学生平价梯子";

const list = AIRPORTS.filter(a => a.startingPrice <= 15).sort((a, b) => a.startingPrice - b.startingPrice);
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
>
  <div class="max-w-content mx-auto px-4 sm:px-6 pt-4 pb-16">
    <Breadcrumbs
      items={[
        { name: "机场推荐", href: "/recommend/" },
        { name: "便宜低价机场" }
      ]}
    />

    <header class="mb-8">
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight sm:text-4xl">
        便宜低价机场推荐 (¥10元左右入门专区)
      </h1>
      <p class="mt-2 text-sm text-slate-600 max-w-2xl leading-relaxed">
        适合预算有限、每月流量消耗不高或需要小额备用梯子的用户，支持小额月付体验。
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {list.map(airport => (
        <AirportCard airport={airport} />
      ))}
    </div>
  </div>
</BaseLayout>
