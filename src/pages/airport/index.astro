---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AirportCard from '../../components/AirportCard.astro';
import { AIRPORTS } from '../../data/airports';

const title = "翻墙机场数据库与品牌参数档案 (14家核心品牌) - 竹梯子博客";
const description = "专业翻墙机场数据库与品牌资料档案。完整记录14家核心品牌套餐资费、节点协议、覆盖国家、设备限制与实测数据来源。";
const keywords = "翻墙机场数据库, 机场资料库, 机场参数档案, 机场价格表, 节点协议, 设备限制, 翻墙梯子推荐";
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
>
  <div class="max-w-content mx-auto px-4 sm:px-6 pt-4 pb-16">
    <Breadcrumbs items={[{ name: "机场资料库" }]} />

    <header class="mb-10 text-center sm:text-left">
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight sm:text-4xl">
        翻墙机场数据库与品牌资料库 (14家核心品牌)
      </h1>
      <p class="mt-2 text-sm text-slate-600 max-w-2xl leading-relaxed">
        统一管理所有纳入评测监控的机场服务商基础参数、套餐配置及核验状态。
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {AIRPORTS.map(airport => (
        <AirportCard airport={airport} />
      ))}
    </div>
  </div>
</BaseLayout>
