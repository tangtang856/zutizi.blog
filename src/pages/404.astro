---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "404 - 页面未找到 - 竹梯子博客";
const description = "抱歉，您访问的页面不存在或已被移除。您可以返回首页或浏览热门机场排行榜与推荐专题。";
---

<BaseLayout title={title} description={description}>
  <div class="max-w-content mx-auto px-4 sm:px-6 py-20 text-center">
    <div class="text-7xl font-extrabold text-blue-600 mb-4 font-mono">404</div>
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-3">抱歉，您访问的页面不存在</h1>
    <p class="text-slate-600 text-sm max-w-md mx-auto mb-8">
      可能该页面链接已变更或已被移除。建议您返回首页或查阅下方精选专区。
    </p>
    <div class="flex items-center justify-center gap-3">
      <a href="/" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs py-2.5 px-5 rounded-lg transition">
        返回首页
      </a>
      <a href="/ranking/overall/" class="bg-slate-200 hover:bg-slate-300 text-slate-800 font-semibold text-xs py-2.5 px-5 rounded-lg transition">
        查看机场排行榜
      </a>
    </div>
  </div>
</BaseLayout>
