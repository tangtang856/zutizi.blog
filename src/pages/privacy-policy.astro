---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const title = "隐私政策 - 保护读者个人数据与隐私安全 - 竹梯子博客";
const description = "竹梯子博客隐私政策。阐明本站作为纯静态内容网站，不收集任何用户隐私数据、不使用跟踪Cookie、保护访客安全的政策规范。";
const keywords = "隐私政策, 个人信息保护, 零Cookie跟踪, 数据安全声明";
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <div class="max-w-content mx-auto px-4 sm:px-6 pt-4 pb-16">
    <Breadcrumbs items={[{ name: "隐私政策" }]} />
    <div class="max-w-reading mx-auto mt-4 bg-white rounded-2xl border border-slate-200 p-6 sm:p-10 shadow-sm leading-relaxed text-sm text-slate-700">
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mb-6 border-b border-slate-100 pb-4">隐私政策 (Privacy Policy)</h1>
      <p class="mb-4">生效日期：2026年11月26日</p>
      <p class="mb-4">
        <strong>竹梯子博客 (zutizi.blog)</strong> 尊重并高度保护所有访问者的个人隐私权益。本站采用现代纯静态架构，不设用户注册登录，亦不收集读者任何敏感个人数据。
      </p>
      <h2 class="text-xl font-bold text-slate-900 mt-6 mb-3 border-l-4 border-blue-600 pl-3">1. 数据的收集与使用</h2>
      <p class="mb-4">
        本站不记录您的姓名、身份证号或银行卡账号。第三方 CDN（如 Cloudflare）可能会收集匿名访问日志（如 IP、访问时间、请求路径），仅用于网站安全防护与反 DDoS 攻击。
      </p>
      <h2 class="text-xl font-bold text-slate-900 mt-6 mb-3 border-l-4 border-blue-600 pl-3">2. 外部第三方链接</h2>
      <p>
        本站包含直达各机场官方网站的外部链接。当您点击离开本站后，请参阅目标网站的隐私条款，本站不对外部站点的隐私实践承担法律责任。
      </p>
    </div>
  </div>
</BaseLayout>
