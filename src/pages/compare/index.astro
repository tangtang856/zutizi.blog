---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { AIRPORTS } from '../../data/airports';

const title = "机场横向对比工具 - 2至4家品牌参数/价格/流量横向比较 - 竹梯子博客";
const description = "专业翻墙机场横向对比工具。支持在14家核心品牌中自由勾选2-4家，实时比对套餐资费、每GB单价、节点覆盖、协议支持、AI流媒体解锁能力。";
const keywords = "机场横向对比, 梯子对比, 机场价格比较, 翻墙机场比较工具, 每GB单价测算";
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
>
  <div class="max-w-content mx-auto px-4 sm:px-6 pt-4 pb-16">
    <Breadcrumbs items={[{ name: "横向对比" }]} />

    <header class="mb-8">
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight sm:text-4xl">
        机场横向比较系统 (14家核心品牌库)
      </h1>
      <p class="mt-2 text-sm text-slate-600 max-w-2xl leading-relaxed">
        自由勾选 2 到 4 家候选品牌，系统自动提取统一数据库中的套餐价格、流量配额、每GB单价与节点特性进行深度横向比对。
      </p>
    </header>

    <!-- Selector Chips -->
    <div class="bg-white border border-slate-200 rounded-2xl p-5 mb-8 shadow-sm">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-bold text-slate-700 uppercase tracking-wider">选择候选品牌（最多4家）</span>
        <span id="selected-count" class="text-xs text-blue-600 font-semibold">已选 3 家</span>
      </div>
      <div class="flex flex-wrap gap-2" id="brand-selector">
        {AIRPORTS.map((a, idx) => (
          <label class="cursor-pointer select-none">
            <input
              type="checkbox"
              value={a.id}
              class="hidden peer airport-checkbox"
              checked={idx < 3}
            />
            <span class="inline-block text-xs font-medium px-3 py-1.5 rounded-lg border border-slate-200 bg-slate-50 text-slate-700 peer-checked:bg-blue-600 peer-checked:text-white peer-checked:border-blue-600 transition">
              {a.name}
            </span>
          </label>
        ))}
      </div>
    </div>

    <!-- Comparison Table Output -->
    <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm border-collapse" id="compare-table">
          <!-- Populated by JS -->
        </table>
      </div>
    </div>
  </div>
</BaseLayout>

<script define:vars={{ AIRPORTS }}>
  const checkboxes = document.querySelectorAll('.airport-checkbox');
  const countEl = document.getElementById('selected-count');
  const table = document.getElementById('compare-table');

  function renderTable() {
    const selectedIds = Array.from(checkboxes)
      .filter(cb => cb.checked)
      .map(cb => cb.value);

    if (countEl) countEl.textContent = `已选 ${selectedIds.length} 家 (建议2-4家)`;

    const selectedAirports = AIRPORTS.filter(a => selectedIds.includes(a.id));

    if (selectedAirports.length === 0) {
      table.innerHTML = `<tr><td class="p-8 text-center text-slate-400">请在上方至少勾选 1 个品牌进行对比。</td></tr>`;
      return;
    }

    const rows = [
      { label: "品牌名称", fn: a => `<strong class="text-slate-900 text-base">${a.name}</strong>` },
      { label: "起步资费", fn: a => `<span class="text-blue-600 font-extrabold text-base">¥${a.startingPrice.toFixed(Number.isInteger(a.startingPrice)?0:1)}</span> /${a.plans[0].billing}` },
      { label: "首月流量", fn: a => `<strong>${a.plans[0].trafficGb} GB</strong>` },
      { label: "每GB折算成本", fn: a => `<span class="font-mono text-emerald-600 font-bold">¥${a.plans[0].pricePerGb.toFixed(3)}/GB</span>` },
      { label: "优惠券码", fn: a => a.coupon ? `<code class="bg-blue-50 text-blue-600 px-2 py-0.5 rounded font-mono font-bold">${a.coupon}</code>` : '<span class="text-slate-400">-</span>' },
      { label: "节点协议", fn: a => a.protocols.join(", ") },
      { label: "覆盖地区", fn: a => a.regions.slice(0, 5).join("、") },
      { label: "并发设备限制", fn: a => a.deviceLimit },
      { label: "AI 工具解锁", fn: a => a.aiSupport.slice(0, 3).join(", ") },
      { label: "流媒体解锁", fn: a => a.streamingSupport.slice(0, 2).join(", ") },
      { label: "核心优势", fn: a => `<span class="text-emerald-700">${a.advantages[0]}</span>` },
      { label: "注意事项", fn: a => `<span class="text-amber-700">${a.disadvantages[0]}</span>` },
      { label: "官方直达", fn: a => `<a href="${a.affiliateUrl}" target="_blank" rel="noopener nofollow" class="inline-block bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold py-1.5 px-3 rounded">官网直达</a> <a href="/review/${a.slug}/" class="text-blue-600 underline text-xs ml-2">评测</a>` }
    ];

    let html = `<thead><tr class="bg-slate-50 border-b border-slate-200">
      <th class="py-3 px-4 font-bold text-slate-700 w-36">对比维度</th>
      ${selectedAirports.map(a => `<th class="py-3 px-4 font-bold text-slate-900">${a.name}</th>`).join("")}
    </tr></thead><tbody class="divide-y divide-slate-100">`;

    rows.forEach(r => {
      html += `<tr class="hover:bg-slate-50/50">
        <td class="py-3 px-4 font-semibold text-slate-600 bg-slate-50/40">${r.label}</td>
        ${selectedAirports.map(a => `<td class="py-3 px-4 text-slate-700">${r.fn(a)}</td>`).join("")}
      </tr>`;
    });

    html += `</tbody>`;
    table.innerHTML = html;
  }

  checkboxes.forEach(cb => {
    cb.addEventListener('change', () => {
      const checkedCount = Array.from(checkboxes).filter(c => c.checked).length;
      if (checkedCount > 4) {
        cb.checked = false;
        alert("最多同时对比 4 家品牌");
        return;
      }
      renderTable();
    });
  });

  renderTable();
</script>
