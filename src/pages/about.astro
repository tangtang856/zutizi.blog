---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const title = "关于我们 - 竹梯子博客评测团队介绍与建站宗旨 - 竹梯子博客";
const description = "关于竹梯子博客(zutizi.blog)。由独立网络工程师与数字游民维护的中文科学上网测速与技术资讯门户。坚持客观中立、实测优先。";
const keywords = "关于竹梯子, 博客简介, 客观中立评测团队, 科学上网测速团队";
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <div class="max-w-content mx-auto px-4 sm:px-6 pt-4 pb-16">
    <Breadcrumbs items={[{ name: "关于我们" }]} />
    <div class="max-w-reading mx-auto mt-4 bg-white rounded-2xl border border-slate-200 p-6 sm:p-10 shadow-sm leading-relaxed text-sm text-slate-700">
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mb-6 border-b border-slate-100 pb-4">关于 竹梯子博客 (zutizi.blog)</h1>
      <p class="mb-4">
        <strong>竹梯子博客 (zutizi.blog)</strong> 是一家致力于为全球中文用户提供<strong>客观、中立、基于真实网络拨测数据</strong>的科学上网与跨境网络访问资讯平台。
      </p>
      <h2 class="text-xl font-bold text-slate-900 mt-6 mb-3 border-l-4 border-blue-600 pl-3">我们的评测准则</h2>
      <ul class="list-disc pl-5 space-y-2 mb-6">
        <li><strong>区分官方宣传与实测：</strong>绝不将机场官方单方面宣传的带宽当做实际速度；</li>
        <li><strong>晚高峰实测驱动：</strong>所有评测均在 20:30-23:00 晚高峰多运营商千兆宽带下进行；</li>
        <li><strong>坚持月付防跑路：</strong>始终建议用户坚持“小额月付体验”，规避行业潜在风险；</li>
        <li><strong>无虚假刷榜：</strong>排行榜评分规则透明公开，按实际测速丢包与每GB单价严谨排列。</li>
      </ul>
      <h2 class="text-xl font-bold text-slate-900 mt-6 mb-3 border-l-4 border-blue-600 pl-3">联系与反馈</h2>
      <p>如果您对本站评测数据有疑问，或发现某服务商出现跑路、变质情况，欢迎通过 <a href="/contact/" class="text-blue-600 underline">联系我们</a> 提交监督线索。</p>
    </div>
  </div>
</BaseLayout>
