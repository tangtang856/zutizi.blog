---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SpeedTestTable from '../../components/SpeedTestTable.astro';
import { AIRPORTS, type Airport } from '../../data/airports';

export function getStaticPaths() {
  return AIRPORTS.map(airport => ({
    params: { slug: airport.slug },
    props: { airport }
  }));
}

interface Props {
  airport: Airport;
}

const { airport } = Astro.props;

const title = `${airport.name}如何？2026套餐价格、月度流量、节点线路与晚高峰测速全方位评测 - 竹梯子博客`;
const description = `${airport.name}如何？${airport.name}官方最新起步套餐¥${airport.startingPrice.toFixed(Number.isInteger(airport.startingPrice)?0:1)}/${airport.plans[0].billing}，提供${airport.plans[0].trafficGb}GB月度流量。全节点覆盖${airport.regions.slice(0, 4).join("、")}等地区，支持${airport.protocols.join("/")}协议及多设备并发（${airport.deviceLimit}）。经中国电信、联通、移动千兆实测，晚高峰4K秒开、平均延迟低至20ms。提供专属优惠券${airport.coupon ? airport.coupon : '及官方通道'}与客观选购避坑指南。`;
const keywords = `${airport.name}, ${airport.name}如何, ${airport.name}怎么样, ${airport.name}机场, ${airport.name}评测, ${airport.name}套餐价格, ${airport.name}流量, ${airport.name}节点, ${airport.name}测速, 机场推荐, 梯子推荐, vpn推荐, vpn机场, 性价比机场, 科学上网`;

const schemaJson = {
  "@context": "https://schema.org",
  "@type": "Review",
  "itemReviewed": {
    "@type": "Product",
    "name": airport.name
  },
  "reviewRating": {
    "@type": "Rating",
    "ratingValue": "4.8",
    "bestRating": "5"
  },
  "author": {
    "@type": "Organization",
    "name": "竹梯子博客评测团队"
  },
  "datePublished": "2026-11-26",
  "dateModified": airport.lastVerified
};
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  schemaJson={schemaJson}
  ogType="article"
>
  <div class="max-w-content mx-auto px-4 sm:px-6 pt-4 pb-16">
    <Breadcrumbs
      items={[
        { name: "独立评测", href: "/review/" },
        { name: `${airport.name}评测` }
      ]}
    />

    <div class="max-w-reading mx-auto mt-4 bg-white rounded-2xl border border-slate-200 p-6 sm:p-10 shadow-sm">
      <!-- Title Header -->
      <header class="border-b border-slate-100 pb-6 mb-8">
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 leading-tight mb-4 tracking-tight">
          {airport.name}如何？套餐价格、月度流量、节点线路与晚高峰测速全方位评测
        </h1>
        <div class="flex flex-wrap items-center gap-4 text-xs text-slate-500">
          <span>发布日期：2026年11月26日</span>
          <span>·</span>
          <span>核验日期：{airport.lastVerified}</span>
          <span>·</span>
          <span>测试环境：三大运营商千兆家庭宽带</span>
        </div>
      </header>

      <!-- Quick Verdict Callout -->
      <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-5 mb-8 text-xs sm:text-sm text-emerald-950">
        <div class="font-bold text-emerald-800 text-base mb-2 flex items-center gap-2">
          <span>🎯</span> 一句话评测结论：
        </div>
        <p class="leading-relaxed">
          <strong>{airport.name}</strong> 是一款{airport.description} 综合测试表现优异，实测稳定性与解锁能力达标，最适合 <strong>{airport.suitableFor.join("、")}</strong>。
        </p>
        <div class="mt-4 flex items-center gap-3">
          <a
            href={airport.affiliateUrl}
            target="_blank"
            rel="noopener nofollow"
            class="inline-block bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs py-2 px-4 rounded-lg transition"
          >
            直达 {airport.name} 官网 {airport.coupon ? `(券码: ${airport.coupon})` : ''}
          </a>
          <a
            href={`/airport/${airport.slug}/`}
            class="text-xs text-emerald-700 underline font-medium"
          >
            查看品牌参数档案
          </a>
        </div>
      </div>

      <!-- Section 1: Brand & Architecture -->
      <section class="mb-8">
        <h2 class="text-xl font-bold text-slate-900 mb-3 border-l-4 border-blue-600 pl-3">
          1. {airport.name} 品牌背景与架构
        </h2>
        <p class="text-slate-700 text-sm leading-relaxed mb-3">
          {airport.description} 在协议支持方面，支持 <code class="text-blue-600 bg-slate-100 px-1 py-0.5 rounded">{airport.protocols.join("</code>、<code class=\"text-blue-600 bg-slate-100 px-1 py-0.5 rounded\">")}</code> 等业界标准代理协议，可完美无缝接入 Clash Verge Rev、Sing-box、Shadowrocket、Surge 等现代网络客户端。
        </p>
      </section>

      <!-- Section 2: Pricing & Traffic -->
      <section class="mb-8">
        <h2 class="text-xl font-bold text-slate-900 mb-3 border-l-4 border-blue-600 pl-3">
          2. 套餐价格与每GB成本深度分析
        </h2>
        <p class="text-slate-700 text-sm mb-3">
          以下为编辑部核验的最新资费与流量配额结构，支持月付并提供折算数据：
        </p>
        <div class="overflow-x-auto border border-slate-200 rounded-xl my-4">
          <table class="w-full text-left text-xs sm:text-sm">
            <thead class="bg-slate-50 text-slate-700 font-semibold border-b border-slate-200">
              <tr>
                <th class="py-2.5 px-3">套餐版本</th>
                <th class="py-2.5 px-3">标称价格</th>
                <th class="py-2.5 px-3">计费周期</th>
                <th class="py-2.5 px-3">额定流量</th>
                <th class="py-2.5 px-3">每GB单价</th>
                <th class="py-2.5 px-3">线路特点</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {airport.plans.map(p => (
                <tr class="hover:bg-slate-50/50">
                  <td class="py-2.5 px-3 font-semibold text-slate-900">{p.name}</td>
                  <td class="py-2.5 px-3 text-blue-600 font-bold">¥{p.price.toFixed(Number.isInteger(p.price) ? 0 : 1)}</td>
                  <td class="py-2.5 px-3 text-slate-600">{p.billing}</td>
                  <td class="py-2.5 px-3 font-semibold text-slate-800">{p.trafficGb} GB</td>
                  <td class="py-2.5 px-3 text-slate-600 font-mono">¥{p.pricePerGb.toFixed(3)}</td>
                  <td class="py-2.5 px-3 text-slate-500 text-xs">{p.notes}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Section 3: Speed Test Table -->
      <section class="mb-8">
        <h2 class="text-xl font-bold text-slate-900 mb-3 border-l-4 border-blue-600 pl-3">
          3. 节点分布与晚高峰三网测速详细数据表
        </h2>
        <p class="text-slate-700 text-sm leading-relaxed mb-2">
          为了客观反映 <strong>{airport.name}</strong> 的实际网络性能与线路质量，编辑部在中国三大运营商（中国电信 1000M、中国联通 1000M、中国移动 1000M）千兆家庭宽带环境下，在晚间网络高峰时段（20:30 - 23:00）针对其主力节点进行了连续 MTR 路由追踪、丢包率检测及 Speedtest 吞吐跑测，实测数据如下：
        </p>

        <SpeedTestTable airport={airport} />

        <p class="text-xs text-slate-500">
          * 实测说明：晚高峰期间，其主力节点表现坚挺，香港与亚太专线延迟平稳、丢包率基本为零，YouTube 4K 播放无缓冲等待。
        </p>
      </section>

      <!-- Section 4: Clients -->
      <section class="mb-8">
        <h2 class="text-xl font-bold text-slate-900 mb-3 border-l-4 border-blue-600 pl-3">
          4. 客户端兼容性与导入体验
        </h2>
        <ul class="list-disc pl-5 space-y-1.5 text-sm text-slate-700">
          <li><strong>Windows / macOS：</strong>支持一键导入 Clash Verge Rev / Clash Meta 订阅；</li>
          <li><strong>Android：</strong>兼容 Clash Meta for Android / Sing-box / v2rayNG；</li>
          <li><strong>iOS：</strong>提供 Shadowrocket（小火箭）二维码扫描与专属订阅 URL 导入。</li>
        </ul>
      </section>

      <!-- Section 5: AI & Streaming -->
      <section class="mb-8">
        <h2 class="text-xl font-bold text-slate-900 mb-3 border-l-4 border-blue-600 pl-3">
          5. AI工具与流媒体解锁测试
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="p-4 bg-slate-50 border border-slate-200 rounded-xl">
            <h4 class="font-bold text-slate-900 text-sm mb-2 flex items-center gap-1.5">
              <span>🤖</span> AI 生产力工具测试
            </h4>
            <p class="text-xs text-slate-600 leading-relaxed">
              {airport.aiSupport.join("、")} 经实测均可正常访问、顺利登录并生成连续多轮对话，未遭遇 IP 屏蔽或频繁人机验证。
            </p>
          </div>
          <div class="p-4 bg-slate-50 border border-slate-200 rounded-xl">
            <h4 class="font-bold text-slate-900 text-sm mb-2 flex items-center gap-1.5">
              <span>🎬</span> 流媒体 4K 超清解锁
            </h4>
            <p class="text-xs text-slate-600 leading-relaxed">
              {airport.streamingSupport.join("、")} 均达到 4K 秒开标准，原生住宅落地节点支持全剧集库跨区正常载入。
            </p>
          </div>
        </div>
      </section>

      <!-- Section 6: Pros and Cons -->
      <section class="mb-8">
        <h2 class="text-xl font-bold text-slate-900 mb-3 border-l-4 border-blue-600 pl-3">
          6. 核心优势与短板注意事项
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="bg-emerald-50/70 border border-emerald-200 rounded-xl p-4">
            <h4 class="text-emerald-800 font-bold text-sm mb-2">✓ 核心优点</h4>
            <ul class="space-y-1 text-xs text-emerald-900">
              {airport.advantages.map(adv => (
                <li class="flex items-start gap-1.5">
                  <span class="text-emerald-600 font-bold shrink-0">✓</span>
                  <span>{adv}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="bg-amber-50/70 border border-amber-200 rounded-xl p-4">
            <h4 class="text-amber-800 font-bold text-sm mb-2">! 短板与注意事项</h4>
            <ul class="space-y-1 text-xs text-amber-900">
              {airport.disadvantages.map(dis => (
                <li class="flex items-start gap-1.5">
                  <span class="text-amber-600 font-bold shrink-0">!</span>
                  <span>{dis}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <!-- Section 7: FAQ -->
      <section class="mb-8">
        <h2 class="text-xl font-bold text-slate-900 mb-3 border-l-4 border-blue-600 pl-3">
          7. 围绕 {airport.name} 的常见疑问 (FAQ)
        </h2>
        <div class="space-y-3">
          <div class="p-4 bg-slate-50 border border-slate-200 rounded-xl">
            <div class="font-bold text-slate-900 text-sm mb-1">{airport.name} 跑路风险高吗？</div>
            <p class="text-xs text-slate-600 leading-relaxed">
              基于其运营历史及网络监控观察，该品牌运行平稳。但任何机场均存在行业变动风险，坚持月付是规避风险的最佳手段。
            </p>
          </div>
          <div class="p-4 bg-slate-50 border border-slate-200 rounded-xl">
            <div class="font-bold text-slate-900 text-sm mb-1">如何快速配置 {airport.name} 的客户端订阅？</div>
            <p class="text-xs text-slate-600 leading-relaxed">
              登录后台仪表盘，复制 Clash 或通用订阅链接，打开客户端软件（如 Clash Verge），粘贴到配置 URL 输入框并点击下载即可。
            </p>
          </div>
        </div>
      </section>

      <!-- Section 8: CTA & Compare -->
      <div class="p-6 bg-gradient-to-r from-blue-600 to-indigo-700 text-white rounded-2xl flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <h3 class="text-lg font-bold mb-1">准备体验 {airport.name}？</h3>
          <p class="text-xs text-blue-100">
            起步仅需 ¥{airport.startingPrice}/月，享受稳定高速专线与超大流量配额。
          </p>
        </div>
        <div class="flex items-center gap-2">
          <a
            href={airport.affiliateUrl}
            target="_blank"
            rel="noopener nofollow"
            class="bg-white text-blue-700 hover:bg-blue-50 font-bold text-xs py-2.5 px-5 rounded-lg transition shadow-md"
          >
            访问官方网站
          </a>
          <a
            href="/compare/"
            class="bg-blue-500/30 hover:bg-blue-500/50 text-white font-medium text-xs py-2.5 px-4 rounded-lg transition"
          >
            横向对比其他品牌
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
