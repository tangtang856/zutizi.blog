---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const title = "联系与商务合作 - 竹梯子博客官方联络通道 - 竹梯子博客";
const description = "联系竹梯子博客(zutizi.blog)。商务合作、网络测速数据修正、服务商品牌收录申请及读者反馈官方联络方式。";
const keywords = "联系我们, 商务合作, 机场收录申请, 测速数据反馈";
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <div class="max-w-content mx-auto px-4 sm:px-6 pt-4 pb-16">
    <Breadcrumbs items={[{ name: "联系我们" }]} />
    <div class="max-w-reading mx-auto mt-4 bg-white rounded-2xl border border-slate-200 p-6 sm:p-10 shadow-sm leading-relaxed text-sm text-slate-700">
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mb-6 border-b border-slate-100 pb-4">联系与商务合作</h1>
      <p class="mb-6">
        欢迎与<strong>竹梯子博客 (zutizi.blog)</strong> 编辑团队建立联系。我们欢迎读者反馈、技术探讨与中立客观的评测样品提供。
      </p>
      <div class="p-5 bg-blue-50 border border-blue-100 rounded-xl mb-6">
        <h3 class="font-bold text-blue-900 mb-2">📮 官方联系邮箱</h3>
        <p class="font-mono text-blue-700 font-semibold text-base">support@zutizi.blog</p>
        <p class="text-xs text-blue-600 mt-1">工作时间：周一至周五 09:00 - 18:00 (UTC+8)，通常在 24 小时内回复。</p>
      </div>
      <h2 class="text-xl font-bold text-slate-900 mt-6 mb-3 border-l-4 border-blue-600 pl-3">合作与收录声明</h2>
      <p>所有申请收录的机场品牌均需接受本站为期 7 天的晚高峰丢包与三网延迟真实测试，严禁任何形式的买榜与虚假数据展示。</p>
    </div>
  </div>
</BaseLayout>
