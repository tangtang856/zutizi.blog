---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const title = "Android安卓手机翻墙与客户端配置教程 - 竹梯子博客";
const description = "Android安卓手机科学上网教程专区。v2rayNG、Clash Meta for Android、Surfboard冲浪板及Sing-box配置使用指南。";
const keywords = "安卓翻墙教程, Android机场配置, v2rayNG使用, 手机梯子设置";

const allGuides = await getCollection('guides');
const androidGuides = allGuides.filter(g => g.slug.startsWith('android'));
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <div class="max-w-content mx-auto px-4 sm:px-6 pt-4 pb-16">
    <Breadcrumbs items={[{ name: "使用教程", href: "/guides/" }, { name: "Android 教程" }]} />
    <header class="mb-8">
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight sm:text-4xl">Android 安卓手机客户端教程专区</h1>
      <p class="mt-2 text-sm text-slate-600 max-w-2xl leading-relaxed">适用于小米、华为、OPPO、vivo 及三星原生安卓系统。</p>
    </header>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {androidGuides.map(guide => (
        <a href={`/guides/${guide.slug}/`} class="p-5 bg-white border border-slate-200 hover:border-blue-500 rounded-xl transition flex flex-col justify-between hover:shadow-md group">
          <div>
            <h3 class="font-bold text-slate-900 text-sm group-hover:text-blue-600 transition mb-2">{guide.data.h1 || guide.data.title}</h3>
            <p class="text-xs text-slate-600 leading-relaxed line-clamp-2">{guide.data.description}</p>
          </div>
          <div class="mt-4 pt-2.5 border-t border-slate-100 text-xs font-semibold text-blue-600 flex items-center justify-between">
            <span>开始学习</span><span>&rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
