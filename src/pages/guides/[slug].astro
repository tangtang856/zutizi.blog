---
import { getCollection } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const guideEntries = await getCollection('guides');
  return guideEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const schemaJson = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": entry.data.h1 || entry.data.title,
  "description": entry.data.description,
  "datePublished": entry.data.publishDate,
  "author": {
    "@type": "Organization",
    "name": entry.data.author
  }
};
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  keywords={entry.data.keywords}
  h1={entry.data.h1 || entry.data.title}
  publishDate={entry.data.publishDate}
  author={entry.data.author}
  breadcrumbs={[
    { name: "使用教程", href: "/guides/" },
    { name: entry.data.platform, href: "/guides/" },
    { name: entry.data.h1 || entry.data.title }
  ]}
  schemaJson={schemaJson}
>
  <div class="mb-6 p-4 bg-blue-50 border border-blue-100 rounded-xl flex items-center justify-between text-xs text-blue-900">
    <span>适配平台：<strong>{entry.data.platform}</strong></span>
    <span>预计阅读：<strong>{entry.data.readTime}</strong></span>
  </div>

  <Content />
</ArticleLayout>
