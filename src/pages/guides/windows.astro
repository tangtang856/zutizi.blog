---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const title = "Windows科学上网客户端使用教程与配置指南 - 竹梯子博客";
const description = "Windows平台科学上网教程专区。涵盖Clash Verge Rev、v2rayN、Sing-box、SwitchyOmega网页分流及TUN虚拟网卡全流量接管完整实操指南。";
const keywords = "Windows科学上网, Clash Verge教程, v2rayN配置, Windows翻墙, TUN模式";

const allGuides = await getCollection('guides');
const windowsGuides = allGuides.filter(g => g.slug.startsWith('windows'));
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
>
  <div class="max-w-content mx-auto px-4 sm:px-6 pt-4 pb-16">
    <Breadcrumbs
      items={[
        { name: "使用教程", href: "/guides/" },
        { name: "Windows 教程" }
      ]}
    />

    <header class="mb-8">
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight sm:text-4xl">
        Windows 科学上网客户端配置教程专区
      </h1>
      <p class="mt-2 text-sm text-slate-600 max-w-2xl leading-relaxed">
        支持 Windows 10 与 11，涵盖 Clash Verge Rev、v2rayN、Sing-box 以及网页级独立分流配置。
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {windowsGuides.map(guide => (
        <a
          href={`/guides/${guide.slug}/`}
          class="p-5 bg-white border border-slate-200 hover:border-blue-500 rounded-xl transition flex flex-col justify-between hover:shadow-md group"
        >
          <div>
            <h3 class="font-bold text-slate-900 text-sm group-hover:text-blue-600 transition mb-2">
              {guide.data.h1 || guide.data.title}
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed line-clamp-2">
              {guide.data.description}
            </p>
          </div>
          <div class="mt-4 pt-2.5 border-t border-slate-100 text-xs font-semibold text-blue-600 flex items-center justify-between">
            <span>开始学习</span>
            <span>&rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
