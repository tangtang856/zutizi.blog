---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const title = "科学上网客户端配置与使用教程中心 (30篇全平台实操) - 竹梯子博客";
const description = "全平台科学上网客户端使用教程中心。详细图解Windows、macOS、Android、iOS、软路由OpenWrt及Linux全平台代理工具订阅导入与分流配置。";
const keywords = "科学上网教程, 翻墙教程, Clash配置指南, v2rayN教程, Shadowrocket导入, Sing-box设置";

const guides = await getCollection('guides');
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
>
  <div class="max-w-content mx-auto px-4 sm:px-6 pt-4 pb-16">
    <Breadcrumbs items={[{ name: "使用教程" }]} />

    <header class="mb-8">
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight sm:text-4xl">
        全平台科学上网客户端配置教程中心 (30篇实操)
      </h1>
      <p class="mt-2 text-sm text-slate-600 max-w-2xl leading-relaxed">
        按操作系统与终端分类，提供详细图文排错、规则分流、TUN全流量代理与自动化导入指南。
      </p>
    </header>

    <!-- Platform Sub Navigation -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-10">
      <a href="/guides/windows/" class="p-4 bg-white border border-slate-200 hover:border-blue-500 rounded-xl text-center transition shadow-sm group">
        <div class="text-2xl mb-1 group-hover:scale-110 transition">🪟</div>
        <div class="font-bold text-slate-900 text-sm">Windows 教程</div>
        <div class="text-[11px] text-slate-400 mt-0.5">Clash Verge / v2rayN</div>
      </a>
      <a href="/guides/macos/" class="p-4 bg-white border border-slate-200 hover:border-blue-500 rounded-xl text-center transition shadow-sm group">
        <div class="text-2xl mb-1 group-hover:scale-110 transition">🍎</div>
        <div class="font-bold text-slate-900 text-sm">macOS 教程</div>
        <div class="text-[11px] text-slate-400 mt-0.5">Surge / 终端代理</div>
      </a>
      <a href="/guides/android/" class="p-4 bg-white border border-slate-200 hover:border-blue-500 rounded-xl text-center transition shadow-sm group">
        <div class="text-2xl mb-1 group-hover:scale-110 transition">🤖</div>
        <div class="font-bold text-slate-900 text-sm">Android 教程</div>
        <div class="text-[11px] text-slate-400 mt-0.5">v2rayNG / Sing-box</div>
      </a>
      <a href="/guides/ios/" class="p-4 bg-white border border-slate-200 hover:border-blue-500 rounded-xl text-center transition shadow-sm group">
        <div class="text-2xl mb-1 group-hover:scale-110 transition">📱</div>
        <div class="font-bold text-slate-900 text-sm">iOS 教程</div>
        <div class="text-[11px] text-slate-400 mt-0.5">小火箭 / Loon / Surge</div>
      </a>
    </div>

    <!-- Guides List -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {guides.map(guide => (
        <a
          href={`/guides/${guide.slug}/`}
          class="p-5 bg-white border border-slate-200 hover:border-blue-500 rounded-xl transition flex flex-col justify-between hover:shadow-md group"
        >
          <div>
            <div class="flex items-center justify-between text-xs mb-2">
              <span class="bg-blue-50 text-blue-700 px-2 py-0.5 rounded font-medium text-[11px]">
                {guide.data.platform}
              </span>
              <span class="text-slate-400 text-[11px]">{guide.data.readTime}</span>
            </div>
            <h3 class="font-bold text-slate-900 text-sm group-hover:text-blue-600 transition mb-1.5">
              {guide.data.h1 || guide.data.title}
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed line-clamp-2">
              {guide.data.description}
            </p>
          </div>
          <div class="mt-4 pt-2.5 border-t border-slate-100 text-xs font-semibold text-blue-600 flex items-center justify-between">
            <span>开始学习</span>
            <span>&rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
