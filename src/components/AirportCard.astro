---
import type { Airport } from '../data/airports';

interface Props {
  airport: Airport;
  featured?: boolean;
}

const { airport, featured = false } = Astro.props;
const minPlan = airport.plans[0];
const isTested = airport.testStatus === 'tested';
---

<div class={`bg-white rounded-xl border transition-all duration-200 flex flex-col justify-between hover:shadow-lg ${
  featured ? 'border-blue-500 ring-2 ring-blue-500/10' : 'border-slate-200 hover:border-slate-300'
}`}>
  <div class="p-5">
    <!-- Header -->
    <div class="flex items-start justify-between gap-2 mb-3">
      <div>
        <h3 class="font-bold text-slate-900 text-lg hover:text-blue-600 transition">
          <a href={`/review/${airport.slug}/`}>{airport.name}</a>
        </h3>
        <p class="text-xs text-slate-500 mt-0.5">{airport.protocols.join(" · ")}</p>
      </div>
      <div class="flex flex-col items-end gap-1">
        <span class={`text-[11px] font-semibold px-2 py-0.5 rounded-full ${
          isTested ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-blue-50 text-blue-700 border border-blue-200'
        }`}>
          {isTested ? '实测通过' : '官方核验'}
        </span>
        {airport.coupon && (
          <span class="text-[10px] bg-amber-50 text-amber-700 border border-amber-200 px-1.5 py-0.5 rounded font-mono font-bold">
            券: {airport.coupon}
          </span>
        )}
      </div>
    </div>

    <!-- Pricing Row -->
    <div class="bg-slate-50 rounded-lg p-3 mb-4 flex items-baseline justify-between">
      <div>
        <span class="text-xs text-slate-500">起步价格</span>
        <div class="flex items-baseline gap-0.5">
          <span class="text-xl font-extrabold text-blue-600">¥{airport.startingPrice.toFixed(Number.isInteger(airport.startingPrice) ? 0 : 1)}</span>
          <span class="text-xs text-slate-500">/{minPlan ? minPlan.billing : '月'}</span>
        </div>
      </div>
      <div class="text-right">
        <span class="text-xs text-slate-500">配额/单价</span>
        <div class="text-xs font-semibold text-slate-700">
          {minPlan ? `${minPlan.trafficGb}GB (¥${minPlan.pricePerGb.toFixed(3)}/GB)` : '-'}
        </div>
      </div>
    </div>

    <!-- Description -->
    <p class="text-xs text-slate-600 leading-relaxed mb-4 line-clamp-2">
      {airport.description}
    </p>

    <!-- Highlights -->
    <ul class="space-y-1.5 text-xs">
      <li class="flex items-center gap-1.5 text-slate-700">
        <span class="text-emerald-500 font-bold">✓</span>
        <span class="truncate">{airport.advantages[0]}</span>
      </li>
      <li class="flex items-center gap-1.5 text-slate-700">
        <span class="text-emerald-500 font-bold">✓</span>
        <span class="truncate">{airport.advantages[1]}</span>
      </li>
      <li class="flex items-center gap-1.5 text-slate-500">
        <span class="text-amber-500 font-bold">!</span>
        <span class="truncate">{airport.disadvantages[0]}</span>
      </li>
    </ul>
  </div>

  <!-- Footer Actions -->
  <div class="p-4 bg-slate-50/70 border-t border-slate-100 rounded-b-xl flex items-center gap-2">
    <a
      href={airport.affiliateUrl}
      target="_blank"
      rel="noopener nofollow"
      class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-medium text-xs py-2 px-3 rounded-lg text-center transition shadow-sm"
    >
      官网直达
    </a>
    <a
      href={`/review/${airport.slug}/`}
      class="bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 text-xs py-2 px-3 rounded-lg text-center transition font-medium"
    >
      深度评测
    </a>
    <a
      href={`/airport/${airport.slug}/`}
      class="bg-white hover:bg-slate-100 text-slate-500 border border-slate-200 text-xs py-2 px-2.5 rounded-lg text-center transition"
      title="配置参数档案"
    >
      参数
    </a>
  </div>
</div>
