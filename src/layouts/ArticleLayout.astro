---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

interface BreadcrumbItem {
  name: string;
  href?: string;
}

interface Props {
  title: string;
  description: string;
  keywords?: string;
  h1: string;
  publishDate?: string;
  author?: string;
  breadcrumbs: BreadcrumbItem[];
  schemaJson?: Record<string, any>;
}

const {
  title,
  description,
  keywords,
  h1,
  publishDate = '2026-11-26',
  author = '竹梯子评测团队',
  breadcrumbs,
  schemaJson
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  schemaJson={schemaJson}
  ogType="article"
>
  <div class="max-w-content mx-auto px-4 sm:px-6 pt-4 pb-16">
    <Breadcrumbs items={breadcrumbs} />

    <div class="max-w-reading mx-auto mt-4 bg-white rounded-2xl border border-slate-200 p-6 sm:p-10 shadow-sm">
      <!-- Article Header -->
      <header class="border-b border-slate-100 pb-6 mb-8">
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 leading-tight mb-4 tracking-tight">
          {h1}
        </h1>
        <div class="flex flex-wrap items-center gap-4 text-xs text-slate-500">
          <span class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            作者：<strong class="text-slate-700">{author}</strong>
          </span>
          <span>·</span>
          <span>发布日期：{publishDate}</span>
          <span>·</span>
          <span>实测验证通过</span>
        </div>
      </header>

      <!-- Article Body (Markdown Content) -->
      <article class="prose prose-slate max-w-none prose-headings:font-bold prose-headings:text-slate-900 prose-a:text-blue-600 prose-a:no-underline hover:prose-a:underline prose-code:bg-slate-100 prose-code:text-blue-600 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:before:content-none prose-code:after:content-none leading-relaxed">
        <slot />
      </article>

      <!-- Bottom Author / Safe Box -->
      <div class="mt-12 pt-6 border-t border-slate-100 bg-slate-50/80 rounded-xl p-5 text-xs text-slate-600 flex items-start gap-3">
        <div class="w-8 h-8 rounded-full bg-blue-600 text-white flex items-center justify-center font-bold shrink-0">
          梯
        </div>
        <div>
          <div class="font-bold text-slate-900 mb-1">竹梯子博客 (zutizi.blog) 编辑承诺</div>
          <p class="leading-relaxed">
            本文内容基于真实网络抓包测试、协议特征逆向分析与三大运营商骨干网络拨测。所有观点客观中立，拒绝任何未经核实的虚假测速宣传。选购前请坚持“月付体验”以规避行业风险。
          </p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
